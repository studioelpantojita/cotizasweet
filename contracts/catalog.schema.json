{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "referencePrices": {
      "type": "boolean"
    },
    "products": {
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
          },
          "service": {
            "type": "string",
            "enum": [
              "packs",
              "insumos"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "images": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string",
                  "pattern": "^\\/images\\/[a-z0-9-]+\\.(jpg|png|webp)$"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "caption": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "src",
                "alt",
                "caption"
              ],
              "additionalProperties": false
            }
          },
          "features": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            }
          },
          "conditions": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "variants": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "quality": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "prices": {
                  "type": "object",
                  "properties": {
                    "PEN": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000000
                    },
                    "USD": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000000
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "label",
                "quality",
                "detail",
                "unit",
                "prices"
              ],
              "additionalProperties": false
            }
          },
          "confirmation": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "pending"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "status",
                  "note"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "confirmed"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "validUntil": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "status",
                  "note",
                  "by",
                  "date",
                  "validUntil"
                ],
                "additionalProperties": false
              }
            ]
          },
          "published": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "service",
          "name",
          "summary",
          "description",
          "images",
          "features",
          "conditions",
          "variants",
          "confirmation",
          "published"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "updatedAt",
    "referencePrices",
    "products"
  ],
  "additionalProperties": false
}
