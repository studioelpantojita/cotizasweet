# Copy to .env at repository root. Never commit your .env.
APP_ORIGIN=https://tu-dominio.example
API_BACKEND=dotnet
API_BASE_URL=http://api-dotnet:8000
# Opcionales para la API .NET. El intervalo 0 desactiva el respaldo automático.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# Vacío usa backups junto a DATABASE_PATH. En producción elige almacenamiento persistente.
BACKUP_DIR=
RUC_SERVICE_URL=http://api-python:8000
RUC_PROVIDER=decolecta
RUC_API_TOKEN=
RUC_DAILY_LIMIT=500
RUC_QUOTA_PATH=/app/data/ruc-quota.sqlite
# Clave interna aleatoria de al menos 32 caracteres, compartida solo por los servidores.
INTEGRATION_SERVICE_KEY=
# Google sign-in. Register a web OAuth client and the exact /auth/callback.
OIDC_PROVIDER=google
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Set the same Google web client ID as the audience.
OIDC_AUDIENCE=
OIDC_SCOPE=openid profile email
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ACCOUNT_AUTH_ENABLED=true
# APP_ORIGIN followed by /accounts; an independent random 32-byte hexadecimal key.
ACCOUNT_ISSUER=https://tu-dominio.example/accounts
ACCOUNT_JWT_SECRET=
# Optional external sign-in is separate from the mandatory application credentials.
OIDC_EXTERNAL_LOGIN_ENABLED=false
OIDC_ALLOW_LOCAL_HTTP=false
# Solo tras un proxy que elimine y reemplace la cabecera de IP. Vacío = límite global.
TRUSTED_CLIENT_IP_HEADER=
