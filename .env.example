# Copy to .env at repository root. Never commit your .env.
APP_ORIGIN=https://tu-dominio.example
API_BACKEND=dotnet
API_BASE_URL=http://api-dotnet:8000
RUC_SERVICE_URL=http://api-python:8000
RUC_PROVIDER=decolecta
RUC_API_TOKEN=
# Clave interna aleatoria de al menos 32 caracteres, compartida solo por los servidores.
INTEGRATION_SERVICE_KEY=
# HTTPS issuer from your OIDC provider, exact value including its realm/path.
OIDC_ISSUER=https://identity.example.com/realms/ea-cotiza
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=ea-cotiza-api
OIDC_SCOPE=openid profile email quotes:read quotes:write
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
OIDC_ALLOW_LOCAL_HTTP=false
# Solo tras un proxy que elimine y reemplace la cabecera de IP. Vacío = límite global.
TRUSTED_CLIENT_IP_HEADER=
